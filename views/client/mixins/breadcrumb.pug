mixin box-breadcrumb(data)
  .box-breadcrumb
    .inner-image
      img(
        alt="" 
        src=data.avatar
        )
    .inner-content
      .container
        h1.inner-title #{data.name}
        .inner-list
          a(href="/") Trang Chủ
          if(data.categoryName)
            a(href=`${data.linkCategory}`) #{data.categoryName}
          a(href=`${data.link}`) #{data.name}