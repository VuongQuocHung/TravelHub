extends ../layouts/default.pug
include ../mixins/product.pug

block main
  // Section 9
  .section-9
    .container
      .inner-wrap
        .inner-left
          // Box Filter
          include ../partials/box-filter.pug
          // End Box Filter
        .inner-right
          .inner-info
            h2.inner-title Kết quả tìm kiếm
          .inner-info-2
            .inner-sort
              .inner-label Sắp xếp:
              .inner-list
                button
                  | Giá tăng dần
                  i.fa-solid.fa-square-caret-up
                button
                  | Giá giảm dần
                  i.fa-solid.fa-square-caret-down
                button.active
                  | Khuyến Mại Hot
                  i.fa-solid.fa-tag
                button
                  | Xem Nhiều
                  i.fa-solid.fa-eye
            .inner-count-record
              | Tất cả:
              b 101 Tour
            button.inner-filter-mobile
              span.inner-title Bộ Lọc
              i.fa-solid.fa-filter
          .inner-list-tour
            if (tourList.length > 0)
              each item in tourList
                +product-item(item)
            else
              p
                i Không tìm thấy kết quả.
          // Pagination
          .box-pagination
            button
              i.fa-solid.fa-angles-left
            button.active 1
            button 2
            button 3
            button 4
            button
              i.fa-solid.fa-angles-right
          // End Pagination
  // End Section 9
