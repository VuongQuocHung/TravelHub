extends ../layouts/default.pug


block main
  h1.box-title #{pageTitle}

  .section-8
    form#order-edit-form
      input(type="hidden" id='id' name="id" value=orderDetail.id)
      .inner-group
        label(class="inner-label" for="fullName") Tên khách hàng
        input(type="text" id="fullName" name="fullName" value=orderDetail.fullName)
      .inner-group
        label(class="inner-label" for="phone") Số điện thoại
        input(type="text" id="phone" name="phone" value=orderDetail.phone)
      .inner-group.inner-two-col
        label(class="inner-label" for="note") Ghi chú
        textarea(id="note" name="note") #{orderDetail.note}
      .inner-group
        label(class="inner-label" for="paymentMethod") Phương thức thanh toán
        select(id="paymentMethod" name="paymentMethod")
          each method in paymentMethodList
            option(value=method.value selected=(orderDetail.paymentMethod === method.value)) #{method.label}

      .inner-group
        label(class="inner-label" for="paymentStatus") Trạng thái thanh toán
        select(id="paymentStatus" name="paymentStatus")
          each status in paymentStatusList
            option(
              value=status.value 
              selected=(orderDetail.paymentStatus === status.value)) #{status.label}

      .inner-group
        label(class="inner-label" for="createdAt") Ngày đặt

        input(
          type="datetime-local" 
          id="createdAt" 
          name="createdAt" 
          value=orderDetail.createdAtFormat 
          readonly
          )
      .inner-group
        label(class="inner-label" for="status") Trạng thái
        select(id="status" name="status")
          each status in orderStatusList
             option(
              value=status.value 
              selected=(orderDetail.status === status.value)) #{status.label}

      .inner-group
        label(class="inner-label") Danh sách tour
        .inner-order-list
          .inner-order-item
            .inner-order-image
              img(src="/admin/assets/images/tour-1.jpg", alt="Tour Hạ Long")
            .inner-order-content
              .inner-order-name Tour Hạ Long
              .inner-order-text Người lớn: 3 x 1.500.000đ
              .inner-order-text Trẻ em: 2 x 1.300.000đ
              .inner-order-text Em bé: 2 x 1.000.000đ
              .inner-order-text Ngày khởi hành: 20/10/2024
              .inner-order-text Khởi hành tại: Hà Nội
          .inner-order-item
            each tour in orderDetail.toursChecked
              .inner-order-image
                img(src=tour.avatar, alt=tour.name)
              .inner-order-content
                .inner-order-name #{tour.name}
                .inner-order-text Người lớn: #{tour.quantityAdult} x #{tour.priceNewAdult.toLocaleString("vi-VN")}đ
                .inner-order-text Trẻ em: #{tour.quantityChildren} x #{tour.priceNewChildren.toLocaleString("vi-VN")}đ
                .inner-order-text Em bé: #{tour.quantityBaby} x #{tour.priceNewBaby.toLocaleString("vi-VN")}đ
                .inner-order-text Ngày khởi hành: #{tour.departureDateFormat}
                .inner-order-text Khởi hành tại: #{tour.locationFrom}
      .inner-group
        label(class="inner-label") Thanh toán
        .inner-order-total
          div Tạm tính: #{orderDetail.subTotal.toLocaleString("vi-VN")}đ
          div Giảm: #{orderDetail.discount.toLocaleString("vi-VN")}đ
          //- div Mã giảm: TOURMUAHE2024
          div Thanh toán: <span class="inner-order-price">#{orderDetail.total.toLocaleString("vi-VN")}đ</span>
      .inner-button.inner-two-col
        button Cập nhật
    .inner-back
      a(href="#") Quay lại danh sách


