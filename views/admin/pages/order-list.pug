extends ../layouts/default.pug
include ../mixins/filter.pug 
include ../mixins/search.pug 
include ../mixins/pagination.pug 

block title
  title #{pageTitle}

block main
  h1.box-title Quản lý đơn hàng

  //- Section 4
  .section-4
    .inner-wrap
      .inner-item.inner-label
        <i class="fa-solid fa-filter"></i> Bộ lọc
        +filter-status([
          { value: 'initial', label: 'Khởi tạo' },
          { value: 'done', label: 'Hoàn thành' },
          { value: 'cancel', label: 'Đã hủy' }
        ])

      +filter-date()

      .inner-item
        select(filter="paymentMethod")
          option(value="") Phương thức thanh toán
          each item in paymentMethodList
            option(value=item.value) #{item.label}

      .inner-item
        select(filter="paymentStatus")
          option(value="") Trạng thái thanh toán
          each item in paymentStatusList
            option(value=item.value) #{item.label}

      +filter-reset()
  //- End Section 4

  //- Section 5
  .section-5
    .inner-wrap
      +search()
  //- End Section 5

  //- Section 6
  .section-6
    .table-2
      table
        thead
          tr
            th Mã
            th Thông tin khách
            th Danh sách tour
            th Thanh toán
            th Trạng thái
            th(class="inner-center") Ngày đặt
            th Hành động
        tbody
          each orderDetail in orderList
            tr
              td
                .inner-code #{orderDetail.code}
              td
                div Họ tên: #{orderDetail.fullName}
                div SĐT: #{orderDetail.phone}
                div Ghi chú: #{orderDetail.note}
              td
                each tour in orderDetail.toursChecked
                  .inner-item
                    .inner-image
                      img(src=tour.avatar, alt=tour.name)
                    .inner-content
                      .inner-name #{tour.name}
                      .inner-quantity Người lớn: #{tour.quantityAdult} x #{tour.priceNewAdult.toLocaleString()}đ
                      .inner-quantity Trẻ em: #{tour.quantityChildren} x #{tour.priceNewChildren.toLocaleString()}đ
                      .inner-quantity Em bé: #{tour.quantityBaby} x #{tour.priceNewBaby.toLocaleString("vn-VN")}đ
                
              td
                div Tổng tiền: #{orderDetail.subTotal.toLocaleString("vn-VN")}đ
                div Giảm: #{orderDetail.discount.toLocaleString("vn-VN")}đ
                //- div Mã giảm: TOURMUAHE2024
                div Thanh toán: #{orderDetail.total.toLocaleString("vn-VN")}đ
                div PTTT: #{orderDetail.paymentMethodName}
                div TTTT: #{orderDetail.paymentStatusName}
              td
                div(class=`badge badge-${orderDetail.statusDetail.color}`) #{orderDetail.statusDetail.label}
              td(class="inner-center")
                div #{orderDetail.createdAtFormat}
              td
                .inner-buttons
                  a(
                    href=`/${pathAdmin}/order/edit/${orderDetail.id}` 
                    class="inner-edit"
                    ) <i class="fa-regular fa-pen-to-square"></i>
                  button(
                    class="inner-delete"
                    button-delete
                    data-api=`/${pathAdmin}/order/delete/${orderDetail.id}`
                    ) <i class="fa-regular fa-trash-can"></i>
    
  //- End Section 6

  //- Section 7
  .section-7
    +pagination(paginationData, orderList)
  //- End Section 7